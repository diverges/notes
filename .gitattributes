# Normalize text in the repository and working tree to LF.
* text=auto eol=lf

# Windows command scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep binary assets unchanged.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.zip binary
